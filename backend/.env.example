# Server
PORT=5000
NODE_ENV=development

# Base path the API is mounted under behind a reverse proxy (e.g. /cbt).
# Leave empty for local development (mounts at /api).
BASE_PATH=

# Database (MySQL / Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stackjunior_cbt
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# AI
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL (for CORS). Same-origin behind the proxy; the SPA origin in dev.
CLIENT_URL=http://localhost:3000

# StackJunior identity / SSO API
STACKJUNIOR_BASE_URL=https://stackjunior.com/api
